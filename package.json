{
  "name": "azure-key-vault-rbac-migrator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Desktop and browser tool to migrate Azure Key Vault access policies to RBAC role mappings",
  "author": "Krzysztof Kozlik",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop:dev": "deno desktop --hmr .",
    "desktop:build": "npm run build && deno desktop .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "update-roles": "node scripts/update-builtin-roles.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  }
}
